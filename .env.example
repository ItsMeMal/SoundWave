# Firebase Web SDK configuration for local development.
# These are public client-side values, not server secrets.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
# Optional. Leave empty if Google Analytics is not configured.
VITE_FIREBASE_MEASUREMENT_ID=

# Exact Firestore database ID used by this Firebase project.
VITE_FIRESTORE_DATABASE_ID=your-firestore-database-id
