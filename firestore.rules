rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && !('admin' in request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.get('admin', false) == resource.data.get('admin', false);
      allow delete: if false;

      match /playlists/{playlistId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow delete: if isOwner(userId);
      }

      match /likedTracks/{trackId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.videoId is string;
        allow delete: if isOwner(userId);
      }

      match /history/{historyId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.videoId is string;
        allow delete: if isOwner(userId);
      }

      match /playbackProgress/{trackId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.videoId is string
          && request.resource.data.position is number
          && request.resource.data.position >= 0
          && request.resource.data.position <= 86400;
        allow delete: if isOwner(userId);
      }

      match /listeningSessions/{sessionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.videoId is string
          && request.resource.data.secondsListened is number
          && request.resource.data.secondsListened >= 0
          && request.resource.data.secondsListened <= 86400;
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }
    }
    match /sharedPlaylists/{shareId} {
      // Unlisted share tokens allow direct document reads only, never collection listing.
      allow get: if resource.data.isPublic == true;
      allow list: if false;

      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.shareId == shareId
        && request.resource.data.playlistId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.tracks is list
        && request.resource.data.tracks.size() <= 500
        && request.resource.data.isPublic == true;

      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.shareId == shareId
        && request.resource.data.tracks is list
        && request.resource.data.tracks.size() <= 500
        && request.resource.data.isPublic == true;

      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
